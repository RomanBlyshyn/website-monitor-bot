# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token
# Chat that receives listing alerts (your user ID, a group or a channel)
CHAT_ID=123456789
# Chat allowed to use bot commands; also receives source failure/recovery alerts
ADMIN_CHAT_ID=123456789

# Optional
DB_PATH=data/monitor.db
LOG_LEVEL=INFO
SOURCES_PATH=sources.yaml
# USER_AGENT=Mozilla/5.0 (compatible; WebsiteMonitorBot/1.0; +https://example.com)
# Build the Docker image with headless Chromium (needed for use_browser: true)
INSTALL_BROWSER=false
